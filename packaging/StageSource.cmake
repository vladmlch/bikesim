cmake_minimum_required(VERSION 3.27)
foreach(_name BIKE_PACKAGE_SOURCE_DIR BIKE_PACKAGE_BUILD_DIR BIKE_PACKAGE_SOURCE_DEPS)
  if(NOT DEFINED ${_name} OR "${${_name}}" STREQUAL "")
    message(FATAL_ERROR "StageSource requires ${_name}")
  endif()
endforeach()
file(REAL_PATH "${BIKE_PACKAGE_SOURCE_DIR}" _source)
file(REAL_PATH "${BIKE_PACKAGE_BUILD_DIR}" _build)
set(_stage "${_build}/package-source-tree")
if(_source STREQUAL _build OR IS_SYMLINK "${_stage}")
  message(FATAL_ERROR "Source-package staging requires a separate nonsymlink build tree")
endif()
file(REMOVE_RECURSE "${_stage}")
file(MAKE_DIRECTORY "${_stage}")
cmake_path(RELATIVE_PATH _build BASE_DIRECTORY "${_source}" OUTPUT_VARIABLE _relative_build)
file(GLOB_RECURSE _files LIST_DIRECTORIES FALSE RELATIVE "${_source}" "${_source}/*")
foreach(_relative IN LISTS _files)
  if(_relative MATCHES "(^|/)([.]deps|[.]venv|[.]git|[.]worktrees|[.]scratch|[.]work|__pycache__)(/|$)"
     OR _relative MATCHES "^(build[^/]*|native/build[^/]*|output)(/|$)"
     OR _relative MATCHES "(^|/)[^/]*[.]py[co]$")
    continue()
  endif()
  # Also cover a nonstandard in-source binaryDir supplied outside presets.
  if(NOT _relative_build MATCHES "^[.][.](/|$)")
    cmake_path(IS_PREFIX _relative_build "${_relative}" NORMALIZE _inside_build)
    if(_inside_build)
      continue()
    endif()
  endif()
  if(IS_SYMLINK "${_source}/${_relative}")
    message(FATAL_ERROR "Source archive requires a regular source file, not a symlink: ${_relative}")
  endif()
  get_filename_component(_parent "${_stage}/${_relative}" DIRECTORY)
  file(MAKE_DIRECTORY "${_parent}")
  # COPY preserves executable permissions of source shell entry points.
  file(COPY "${_source}/${_relative}" DESTINATION "${_parent}")
endforeach()
file(MAKE_DIRECTORY "${_stage}/.deps")
file(COPY "${BIKE_PACKAGE_SOURCE_DEPS}/_archives" DESTINATION "${_stage}/.deps")
