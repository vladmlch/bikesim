cmake_minimum_required(VERSION 3.27)
if(NOT DEFINED BUILD_DIR)
  message(FATAL_ERROR "coverage_smoke requires BUILD_DIR")
endif()
set(_report "${BUILD_DIR}/coverage.lcov")
if(NOT EXISTS "${_report}")
  message(FATAL_ERROR "Missing coverage.lcov; build target coverage first")
endif()
file(SIZE "${_report}" _size)
if(_size EQUAL 0)
  message(FATAL_ERROR "coverage.lcov is empty")
endif()
file(STRINGS "${_report}" _source_lines REGEX "^SF:.*[/\\\\]native[/\\\\]src[/\\\\]")
if(NOT _source_lines)
  message(FATAL_ERROR "coverage.lcov contains no native/src source file")
endif()
if(NOT EXISTS "${BUILD_DIR}/coverage-summary.txt")
  message(FATAL_ERROR "Missing coverage text summary")
endif()
