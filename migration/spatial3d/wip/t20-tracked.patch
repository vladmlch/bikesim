diff --git a/CMakeLists.txt b/CMakeLists.txt
index 821d202..ee5caaf 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -375,6 +375,32 @@ bike_target_strict_policy(bike_random)
 target_include_directories(bike_random SYSTEM PRIVATE
   "${_bike_native_dir}/src")
 
+# bike_terrain: the T20 terrain boundary — grade.py's GradeProfile, the
+# obstacles.py catalogue (incl. the scipy gaussian_filter1d port over the
+# T19 NumpyRng seam), surface.py's registry/SurfaceMap/slip stiffness,
+# profile.py's TrackSpec/build_profile/profile_extent, heightfield.py's
+# field geometry/normalize/fit gate, wheelpath.py's circle-envelope
+# wheel paths, contact_safety.py's single-contact guards, and road.py's
+# generate_road draw sequence. One STATIC library keeps each TU in a
+# single compile-database entry per build graph (the ODR sweep
+# relocatable-links every selected TU into one image). The boundary
+# carries no third-party or Python dependency; the NumpyRng edge is
+# PUBLIC so consumers see the same seeded stream the obstacles use.
+add_library(bike_terrain STATIC
+  "${_bike_native_dir}/src/terrain/types.hpp"
+  "${_bike_native_dir}/src/terrain/profile.hpp"
+  "${_bike_native_dir}/src/terrain/profile.cpp"
+  "${_bike_native_dir}/src/terrain/obstacles.cpp"
+  "${_bike_native_dir}/src/terrain/surface.cpp"
+  "${_bike_native_dir}/src/terrain/heightfield.cpp"
+  "${_bike_native_dir}/src/terrain/contact_safety.cpp"
+  "${_bike_native_dir}/src/terrain/wheelpath.cpp")
+set_target_properties(bike_terrain PROPERTIES POSITION_INDEPENDENT_CODE ON)
+bike_target_strict_policy(bike_terrain)
+target_include_directories(bike_terrain SYSTEM PRIVATE
+  "${_bike_native_dir}/src")
+target_link_libraries(bike_terrain PUBLIC bike_random)
+
 # bike_engine: the pinned error interceptor shared by contract tests and the
 # extension (identical source/context to the legacy bike_native_engine).
 add_library(bike_engine STATIC "${_bike_native_dir}/src/engine_call.cpp")
