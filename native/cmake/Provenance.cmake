# Provenance.cmake — build/dependency provenance for the standalone
# Python-free build (T03).
#
#   * bike_write_dependency_provenance(<file>) — records which locked,
#     hash-verified dependency artifacts this build consumed, the compiler/
#     SDK identity and the bindings/GUI mode. Written at every configure so a
#     produced binary tree can be tied back to its exact inputs.
#   * bike_register_migration_t03(<repo_root>) — generates the CTest script
#     for the migration_T03 regression and registers the test plus the custom
#     build target of the same name (depending on the native executables the
#     script uses). The script runs the produced command contract end to end:
#     bindings-OFF configure with find_package(Python*) disabled, focused
#     build, nested CTest, no-Python-path scans, RPATH/load-command audit and
#     the mandatory negative acquisitions (missing root, wrong version,
#     tampered artifact, missing error ABI).

# ---------------------------------------------------------------------------
function(bike_write_dependency_provenance output_file)
  if(NOT BIKE_DEP_PROVENANCE_FRAGMENTS)
    message(FATAL_ERROR "bike_write_dependency_provenance called before bike_dependencies_resolve()")
  endif()
  string(JOIN "," _dep_fragments ${BIKE_DEP_PROVENANCE_FRAGMENTS})
  set(_dep_bindings_json "false")
  if(BIKE_BUILD_PYTHON_BINDINGS)
    set(_dep_bindings_json "true")
  endif()
  set(_dep_gui_json "false")
  if(BIKE_BUILD_GUI)
    set(_dep_gui_json "true")
  endif()
  file(WRITE "${output_file}"
    "{\n"
    "  \"schema_version\": 1,\n"
    "  \"generated_by\": \"bike_write_dependency_provenance (native/cmake/Provenance.cmake)\",\n"
    "  \"dependency_root\": \"${BIKE_DEPENDENCY_ROOT}\",\n"
    "  \"dependency_lock\": \"${BIKE_DEPENDENCY_LOCK}\",\n"
    "  \"build_python_bindings\": ${_dep_bindings_json},\n"
    "  \"build_gui\": ${_dep_gui_json},\n"
    "  \"cmake_version\": \"${CMAKE_VERSION}\",\n"
    "  \"cxx_compiler\": \"${CMAKE_CXX_COMPILER}\",\n"
    "  \"cxx_compiler_id\": \"${CMAKE_CXX_COMPILER_ID}\",\n"
    "  \"cxx_compiler_version\": \"${CMAKE_CXX_COMPILER_VERSION}\",\n"
    "  \"osx_sysroot\": \"${CMAKE_OSX_SYSROOT}\",\n"
    "  \"dependencies\": {${_dep_fragments}}\n"
    "}\n")
endfunction()

# ---------------------------------------------------------------------------
# Generate and register the migration_T03 CTest script test + build target.
# dep_root/lock_file are the values the nested contract configures must use.
function(bike_register_migration_t03 repo_root dep_root lock_file)
  if(TARGET migration_T03)
    return()
  endif()
  set(_t03_script "${CMAKE_CURRENT_BINARY_DIR}/migration_T03_check.cmake")
  file(WRITE "${_t03_script}" [==[
# Generated by native/cmake/Provenance.cmake::bike_register_migration_t03.
# CTest script (-P) executing the T03 produced-command contract.
cmake_minimum_required(VERSION 3.24)
foreach(_required_var IN ITEMS BIKE_REPO_ROOT BIKE_DEP_ROOT BIKE_LOCK_FILE BIKE_HOST_BUILD BIKE_CXX BIKE_TARGET_SYSTEM CMAKE_HOST_SYSTEM_PROCESSOR)
  if(NOT DEFINED ${_required_var} OR "${${_required_var}}" STREQUAL "")
    message(FATAL_ERROR "migration_T03: missing -D${_required_var}")
  endif()
endforeach()
get_filename_component(_t03_ctest "${CMAKE_COMMAND}" DIRECTORY)
set(_t03_ctest "${_t03_ctest}/ctest")
if(NOT EXISTS "${_t03_ctest}")
  set(_t03_ctest "ctest")
endif()

# Use the resolver's platform selection even in script mode; the host key is
# passed by the configuring graph because -P has no project/toolchain probe.
set(BIKE_DEPENDENCY_ROOT "${BIKE_DEP_ROOT}")
set(BIKE_DEPENDENCY_LOCK "${BIKE_LOCK_FILE}")
include("${BIKE_REPO_ROOT}/native/cmake/BikeDependencyLock.cmake")
bike_dependency_lock_read(_t03_lock_json)
bike_dependency_lock_select("${_t03_lock_json}" mujoco _t03_mj_selected _t03_mj_required)
if(NOT _t03_mj_required)
  message(FATAL_ERROR "migration_T03 requires a MuJoCo dependency on this platform")
endif()
string(TOLOWER "${BIKE_TARGET_SYSTEM}" _t03_system)
set(_t03_platform_key "${_t03_system}-${CMAKE_HOST_SYSTEM_PROCESSOR}")
string(JSON _t03_mj_root GET "${_t03_mj_selected}" extracted_root)
string(JSON _t03_mj_archive GET "${_t03_mj_selected}" acquisition archive)
_bike_dep_locked_library("${_t03_lock_json}" mujoco _t03_mj_library)
get_filename_component(_t03_mj_library_name "${_t03_mj_library}" NAME)
set(_t03_expected_mj "${BIKE_DEP_ROOT}/${_t03_mj_root}/${_t03_mj_library}")
file(REAL_PATH "${_t03_expected_mj}" _t03_expected_mj_real)

set(_t03_work "${BIKE_HOST_BUILD}/migration_T03_work")
file(REMOVE_RECURSE "${_t03_work}")
file(MAKE_DIRECTORY "${_t03_work}")

function(_t03_record line)
  get_property(_f GLOBAL PROPERTY T03_FAILURES)
  set_property(GLOBAL PROPERTY T03_FAILURES "${_f}\n  ${line}")
  message(STATUS "migration_T03 FAILURE: ${line}")
endfunction()

# Path tokens that must never appear in the bindings-OFF build closure:
# Python include/lib trees, virtualenv/wheel layouts and nanobind headers.
set(_t03_forbidden_regex "(/[^\"' \t\n]*(site-packages|nanobind|\\.venv|/venv/|cpython-|/include/python|/lib/python|libpython|Python\\.framework|\\.whl)[^\"' \t\n]*)")

function(_t03_scan_no_python label file_path)
  if(NOT EXISTS "${file_path}")
    _t03_record("${label}: expected artifact missing: ${file_path}")
    return()
  endif()
  file(READ "${file_path}" _content)
  string(REGEX MATCHALL "${_t03_forbidden_regex}" _hits "${_content}")
  if(_hits)
    list(REMOVE_DUPLICATES _hits)
    string(JOIN " ; " _hit_text ${_hits})
    _t03_record("${label}: Python/venv path token(s) in ${file_path}: ${_hit_text}")
  else()
    message(STATUS "migration_T03: ${label} clean (${file_path})")
  endif()
endfunction()

function(_t03_configure rc_var log_var build_dir dep_root lock_file)
  execute_process(
    COMMAND "${CMAKE_COMMAND}" -S "${BIKE_REPO_ROOT}" -B "${build_dir}"
      -DCMAKE_BUILD_TYPE=Release
      "-DCMAKE_CXX_COMPILER=${BIKE_CXX}"
      -DBIKE_BUILD_PYTHON_BINDINGS=OFF
      -DBIKE_BUILD_GUI=OFF
      -DCMAKE_DISABLE_FIND_PACKAGE_Python=ON
      -DCMAKE_DISABLE_FIND_PACKAGE_Python3=ON
      "-DBIKE_DEPENDENCY_ROOT=${dep_root}"
      "-DBIKE_DEPENDENCY_LOCK=${lock_file}"
      ${ARGN}
    RESULT_VARIABLE _rc
    OUTPUT_VARIABLE _out
    ERROR_VARIABLE _err)
  set(${rc_var} "${_rc}" PARENT_SCOPE)
  set(${log_var} "${_out}${_err}" PARENT_SCOPE)
endfunction()

# --- Case 1: produced command contract, bindings OFF, Python discovery disabled
set(_t03_np "${_t03_work}/no-python")
_t03_configure(_t03_np_rc _t03_np_log "${_t03_np}" "${BIKE_DEP_ROOT}" "${BIKE_LOCK_FILE}")
file(WRITE "${_t03_work}/no-python-configure.log" "${_t03_np_log}")
if(NOT _t03_np_rc EQUAL 0)
  message(FATAL_ERROR "migration_T03: bindings-OFF configure failed (${_t03_np_rc}):\n${_t03_np_log}")
endif()
if(NOT _t03_np_log MATCHES "dependency mujoco 3.12.0")
  _t03_record("OFF configure log is missing the locked-dependency report lines")
endif()
if(_t03_np_log MATCHES "[Ff]ound Python")
  _t03_record("OFF configure log reports a Python package discovery")
endif()
_t03_scan_no_python("configure-log" "${_t03_work}/no-python-configure.log")
_t03_scan_no_python("CMakeCache" "${_t03_np}/CMakeCache.txt")
_t03_scan_no_python("compile_commands" "${_t03_np}/compile_commands.json")
if(NOT EXISTS "${_t03_np}/dependency_provenance.json")
  _t03_record("dependency_provenance.json missing from the bindings-OFF build")
else()
  file(READ "${_t03_np}/dependency_provenance.json" _prov)
  if(NOT _prov MATCHES "\"version\":\"3.12.0\"")
    _t03_record("dependency_provenance.json does not record mujoco 3.12.0")
  endif()
endif()

execute_process(
  COMMAND "${CMAKE_COMMAND}" --build "${_t03_np}"
    --target native_distance_tests native_station_tests
  RESULT_VARIABLE _t03_build_rc
  OUTPUT_VARIABLE _t03_build_out
  ERROR_VARIABLE _t03_build_err)
file(WRITE "${_t03_work}/no-python-build.log" "${_t03_build_out}${_t03_build_err}")
if(NOT _t03_build_rc EQUAL 0)
  message(FATAL_ERROR "migration_T03: bindings-OFF focused build failed (${_t03_build_rc}):\n${_t03_build_out}${_t03_build_err}")
endif()
foreach(_bin native_distance_tests native_station_tests)
  if(NOT EXISTS "${_t03_np}/${_bin}")
    _t03_record("focused build did not produce ${_bin}")
  endif()
endforeach()

execute_process(
  COMMAND "${_t03_ctest}" --test-dir "${_t03_np}"
    -R "native_(distance|station)_tests" --output-on-failure --no-tests=error
  RESULT_VARIABLE _t03_ctest_rc
  OUTPUT_VARIABLE _t03_ctest_out
  ERROR_VARIABLE _t03_ctest_err)
file(WRITE "${_t03_work}/no-python-ctest.log" "${_t03_ctest_out}${_t03_ctest_err}")
if(NOT _t03_ctest_rc EQUAL 0 OR NOT _t03_ctest_out MATCHES "tests passed")
  _t03_record("nested ctest failed (${_t03_ctest_rc}): ${_t03_ctest_out}${_t03_ctest_err}")
endif()

# --- Case 2: relocation/RPATH audit — no developer .venv/wheel path may be
# embedded in a produced binary, and libmujoco must resolve to the locked
# dependency root (never to a Python package directory).
set(_t03_audit_bins
  "${_t03_np}/native_distance_tests" "${_t03_np}/native_station_tests")
# Host binaries are audited only in the root graph. The binding graph links
# the interpreter-provided MuJoCo intentionally and has a different closure.
if(BIKE_HOST_IS_ROOT)
  list(APPEND _t03_audit_bins
    "${BIKE_HOST_BUILD}/native_distance_tests"
    "${BIKE_HOST_BUILD}/native_station_tests"
    "${BIKE_HOST_BUILD}/native_bench")
endif()
foreach(_bin IN LISTS _t03_audit_bins)
  if(NOT EXISTS "${_bin}")
    continue()
  endif()
  if(CMAKE_HOST_APPLE)
    execute_process(COMMAND otool -L "${_bin}"
      RESULT_VARIABLE _load_rc OUTPUT_VARIABLE _load_out ERROR_VARIABLE _load_err)
    execute_process(COMMAND otool -l "${_bin}"
      RESULT_VARIABLE _paths_rc OUTPUT_VARIABLE _paths_out ERROR_VARIABLE _paths_err)
    string(FIND "${_load_out}" "${_t03_expected_mj}" _locked_at)
    if(_locked_at EQUAL -1)
      _t03_record("${_bin} resolves libmujoco outside the locked dependency root")
    endif()
  else()
    execute_process(COMMAND ldd "${_bin}"
      RESULT_VARIABLE _load_rc OUTPUT_VARIABLE _load_out ERROR_VARIABLE _load_err)
    execute_process(COMMAND readelf -d "${_bin}"
      RESULT_VARIABLE _paths_rc OUTPUT_VARIABLE _paths_out ERROR_VARIABLE _paths_err)
    string(REGEX MATCH "libmujoco[^ \t\r\n]*[ \t]+=>[ \t]+([^ \t\r\n]+)" _resolved_match "${_load_out}")
    if(_resolved_match)
      file(REAL_PATH "${CMAKE_MATCH_1}" _resolved_mj)
      if(NOT _resolved_mj STREQUAL _t03_expected_mj_real)
        _t03_record("${_bin} resolves libmujoco outside the locked dependency root: ${_resolved_mj}")
      endif()
    else()
      _t03_record("${_bin} has no resolved locked MuJoCo image in ldd output")
    endif()
  endif()
  if(NOT _load_rc EQUAL 0 OR NOT _paths_rc EQUAL 0)
    _t03_record("loader audit failed on ${_bin}: ${_load_rc}/${_paths_rc}: ${_load_err}${_paths_err}")
  endif()
  if(_load_out MATCHES "not found")
    _t03_record("unresolved shared dependency in ${_bin}: ${_load_out}")
  endif()
  if("${_load_out}\n${_paths_out}" MATCHES "libpython|Python\\.framework")
    _t03_record("Python runtime dependency in ${_bin}")
  endif()
  string(FIND "${_load_out}" "${_t03_mj_library_name}" _mujoco_at)
  if(_mujoco_at EQUAL -1)
    _t03_record("${_bin} does not link ${_t03_mj_library_name}")
  endif()
  string(REGEX MATCHALL "${_t03_forbidden_regex}" _forbidden "${_load_out}\n${_paths_out}")
  if(_forbidden)
    _t03_record("forbidden load/RPATH path in ${_bin}: ${_forbidden}")
  endif()
endforeach()

# Focused installs keep OPTIONAL executables and must preserve the no-Python
# closure on both platforms. install_smoke separately builds/audits all entries.
execute_process(
  COMMAND "${CMAKE_COMMAND}" --install "${_t03_np}"
    --prefix "${_t03_work}/install"
  RESULT_VARIABLE _inst_rc OUTPUT_VARIABLE _inst_out ERROR_VARIABLE _inst_err)
if(NOT _inst_rc EQUAL 0)
  _t03_record("cmake --install of the bindings-OFF build failed (${_inst_rc}): ${_inst_err}")
else()
  file(GLOB_RECURSE _inst_bins "${_t03_work}/install/bin/*")
  foreach(_bin IN LISTS _inst_bins)
    if(CMAKE_HOST_APPLE)
      execute_process(COMMAND otool -L "${_bin}"
        RESULT_VARIABLE _iot_rc OUTPUT_VARIABLE _iot_out ERROR_VARIABLE _iot_err)
    else()
      execute_process(COMMAND readelf -d "${_bin}"
        RESULT_VARIABLE _iot_rc OUTPUT_VARIABLE _iot_out ERROR_VARIABLE _iot_err)
    endif()
    if(NOT _iot_rc EQUAL 0)
      _t03_record("loader audit failed on installed ${_bin}: ${_iot_err}")
    endif()
    if(_iot_out MATCHES "libpython|Python\\.framework")
      _t03_record("Python runtime dependency in installed ${_bin}")
    endif()
    string(REGEX MATCHALL "${_t03_forbidden_regex}" _iot_hits "${_iot_out}")
    if(_iot_hits)
      _t03_record("forbidden load path in installed ${_bin}: ${_iot_hits}")
    endif()
  endforeach()
endif()

# --- Case 3: missing dependency root must fail before any application build.
_t03_configure(_t03_miss_rc _t03_miss_log "${_t03_work}/cfg-missing"
  "${_t03_work}/deps-absent" "${BIKE_LOCK_FILE}")
if(_t03_miss_rc EQUAL 0)
  _t03_record("configure succeeded with a missing BIKE_DEPENDENCY_ROOT")
elseif(NOT _t03_miss_log MATCHES "dependency acquisition failure")
  _t03_record("missing-root configure failed for an unexpected reason: ${_t03_miss_log}")
endif()

# Scratch lock carrying only the mujoco member (keeps each negative case
# isolated to a single dependency).
string(JSON _t03_mj GET "${_t03_lock_json}" dependencies mujoco)
file(WRITE "${_t03_work}/lock-mujoco.json"
  "{\n \"schema_version\": 2,\n \"dependencies\": {\n  \"mujoco\": ${_t03_mj}\n }\n}\n")

# --- Case 4: invalid MuJoCo version must fail before any application build.
set(_t03_badver "${_t03_work}/deps-badver")
file(MAKE_DIRECTORY "${_t03_badver}/_archives")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_directory
  "${BIKE_DEP_ROOT}/${_t03_mj_root}" "${_t03_badver}/${_t03_mj_root}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E create_symlink
  "${BIKE_DEP_ROOT}/${_t03_mj_archive}"
  "${_t03_badver}/${_t03_mj_archive}")
file(WRITE "${_t03_badver}/${_t03_mj_root}/BIKE_VERSION" "3.99.0\n")
_t03_configure(_t03_badver_rc _t03_badver_log "${_t03_work}/cfg-badver"
  "${_t03_badver}" "${_t03_work}/lock-mujoco.json")
if(_t03_badver_rc EQUAL 0)
  _t03_record("configure accepted an invalid MuJoCo version (VERSION=3.99.0)")
elseif(NOT _t03_badver_log MATCHES "requires version '3.12.0'")
  _t03_record("bad-version configure failed for an unexpected reason: ${_t03_badver_log}")
endif()

# --- Case 5: tampered artifact must fail the locked sha256 before build.
set(_t03_tampered "${_t03_work}/deps-tampered")
file(MAKE_DIRECTORY "${_t03_tampered}/_archives")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_directory
  "${BIKE_DEP_ROOT}/${_t03_mj_root}" "${_t03_tampered}/${_t03_mj_root}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E create_symlink
  "${BIKE_DEP_ROOT}/${_t03_mj_archive}"
  "${_t03_tampered}/${_t03_mj_archive}")
file(APPEND "${_t03_tampered}/${_t03_mj_root}/${_t03_mj_library}" "\n")
_t03_configure(_t03_tamper_rc _t03_tamper_log "${_t03_work}/cfg-tampered"
  "${_t03_tampered}" "${_t03_work}/lock-mujoco.json")
if(_t03_tamper_rc EQUAL 0)
  _t03_record("configure accepted a sha256-tampered libmujoco image")
elseif(NOT _t03_tamper_log MATCHES "sha256 mismatch")
  _t03_record("tampered configure failed for an unexpected reason: ${_t03_tamper_log}")
endif()

# --- Case 6: hash-clean artifact lacking the private TLS error ABI must fail.
set(_t03_noabi "${_t03_work}/deps-noabi")
file(MAKE_DIRECTORY "${_t03_noabi}/_archives" "${_t03_noabi}/${_t03_mj_root}/lib")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_directory
  "${BIKE_DEP_ROOT}/${_t03_mj_root}/include" "${_t03_noabi}/${_t03_mj_root}/include")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy
  "${BIKE_DEP_ROOT}/${_t03_mj_root}/BIKE_VERSION" "${_t03_noabi}/${_t03_mj_root}/BIKE_VERSION")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy
  "${BIKE_DEP_ROOT}/${_t03_mj_root}/LICENSE" "${_t03_noabi}/${_t03_mj_root}/LICENSE")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy
  "${BIKE_DEP_ROOT}/${_t03_mj_root}/LICENSES_THIRD_PARTY.md" "${_t03_noabi}/${_t03_mj_root}/LICENSES_THIRD_PARTY.md")
execute_process(COMMAND "${CMAKE_COMMAND}" -E create_symlink
  "${BIKE_DEP_ROOT}/${_t03_mj_archive}"
  "${_t03_noabi}/${_t03_mj_archive}")
# The stub exports only the version symbol so the 3.12.0 probe passes and
# the TLS-ABI probe is the check that must fail.
file(WRITE "${_t03_work}/stub.cpp"
  "extern \"C\" int mj_version(void) { return 3012000; }\n")
if(CMAKE_HOST_APPLE)
  set(_t03_shared_flags -dynamiclib)
else()
  set(_t03_shared_flags -shared -fPIC)
endif()
execute_process(COMMAND "${BIKE_CXX}" ${_t03_shared_flags} "${_t03_work}/stub.cpp"
  -o "${_t03_noabi}/${_t03_mj_root}/${_t03_mj_library}"
  RESULT_VARIABLE _stub_rc OUTPUT_VARIABLE _stub_out ERROR_VARIABLE _stub_err)
if(NOT _stub_rc EQUAL 0)
  message(FATAL_ERROR "migration_T03: cannot compile the ABI stub shared image: ${_stub_err}")
endif()
file(SHA256 "${_t03_noabi}/${_t03_mj_root}/${_t03_mj_library}" _t03_stub_sha)
string(JSON _t03_mj_stub SET "${_t03_mj}"
  platforms "${_t03_platform_key}" required_files "${_t03_mj_library}" "\"${_t03_stub_sha}\"")

file(WRITE "${_t03_work}/lock-mujoco-stub.json"
  "{\n \"schema_version\": 2,\n \"dependencies\": {\n  \"mujoco\": ${_t03_mj_stub}\n }\n}\n")
_t03_configure(_t03_noabi_rc _t03_noabi_log "${_t03_work}/cfg-noabi"
  "${_t03_noabi}" "${_t03_work}/lock-mujoco-stub.json")
if(_t03_noabi_rc EQUAL 0)
  _t03_record("configure accepted a MuJoCo library missing the private TLS error ABI")
elseif(NOT _t03_noabi_log MATCHES "error-handler ABI is unavailable")
  _t03_record("missing-ABI configure failed for an unexpected reason: ${_t03_noabi_log}")
endif()

# --- Case 7: a wrong platform key must never fall back to Darwin or skip.
string(JSON _t03_platform_payload GET "${_t03_mj}" platforms "${_t03_platform_key}")
string(JSON _t03_wrong_platforms SET "{}" plan9-mips "${_t03_platform_payload}")
string(JSON _t03_wrong_lock SET "${_t03_lock_json}" dependencies mujoco platforms "${_t03_wrong_platforms}")
file(WRITE "${_t03_work}/lock-wrong-platform.json" "${_t03_wrong_lock}\n")
_t03_configure(_t03_wrong_rc _t03_wrong_log "${_t03_work}/cfg-wrong-platform"
  "${BIKE_DEP_ROOT}" "${_t03_work}/lock-wrong-platform.json")
if(_t03_wrong_rc EQUAL 0)
  _t03_record("configure accepted a MuJoCo lock with only plan9-mips")
elseif(NOT _t03_wrong_log MATCHES "has no lock entry for platform")
  _t03_record("wrong-platform configure failed for an unexpected reason: ${_t03_wrong_log}")
endif()

get_property(_t03_failures GLOBAL PROPERTY T03_FAILURES)
if(_t03_failures)
  message(FATAL_ERROR "migration_T03:${_t03_failures}")
endif()
message(STATUS "migration_T03: all checks passed")
]==])

  if(BUILD_TESTING)
    set(_t03_host_is_root OFF)
    if(BIKE_ROOT_BUILD)
      set(_t03_host_is_root ON)
    endif()
    add_test(NAME migration_T03
      COMMAND "${CMAKE_COMMAND}"
        "-DBIKE_REPO_ROOT=${repo_root}"
        "-DBIKE_DEP_ROOT=${dep_root}"
        "-DBIKE_LOCK_FILE=${lock_file}"
        "-DBIKE_HOST_BUILD=${CMAKE_BINARY_DIR}"
        "-DBIKE_HOST_IS_ROOT=${_t03_host_is_root}"
        "-DBIKE_CXX=${CMAKE_CXX_COMPILER}"
        "-DBIKE_TARGET_SYSTEM=${BIKE_TARGET_SYSTEM}"
        "-DCMAKE_HOST_SYSTEM_PROCESSOR=${CMAKE_HOST_SYSTEM_PROCESSOR}"
        -P "${_t03_script}")
    set_tests_properties(migration_T03 PROPERTIES TIMEOUT 1200)
  endif()

  # The focused build invocation is real: the custom target builds the native
  # executables the script's assertions exercise.
  add_custom_target(migration_T03
    COMMENT "build the native executables exercised by the migration_T03 contract"
    VERBATIM)
  add_dependencies(migration_T03 native_distance_tests native_station_tests)
endfunction()
