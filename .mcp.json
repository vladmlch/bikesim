{
    "mcpServers": {
        "colab-mcp": {
            "type": "stdio",
            "command": "uvx",
            "args": [
                "git+https://github.com/googlecolab/colab-mcp"
            ],
            "env": {
                "COLAB_AUTHUSER": "9"
            },
            "timeout": 30000
        },
        "idea": {
            "url": "http://127.0.0.1:64342/stream",
            "type": "http"
        }
    }
}
