{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bike-sim:offline-bundle:1",
  "title": "Bike Sim source-authoritative offline bundle, version 1",
  "description": "Structural schema. tools/offline_bundle.py additionally validates source/metadata identity, safe paths, actual bytes, wheel contents and inventory completeness. Qualification is deliberately not established by this manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "format", "profile", "target", "producer", "project", "requirements", "wheels", "files", "qualification"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "format": {"const": "bike-sim-offline"},
    "profile": {"enum": ["full", "slim"]},
    "target": {
      "oneOf": [
        {"const": {"system": "linux", "machine": "x86_64", "python": "3.13", "distribution": "ubuntu", "release": "24.04"}},
        {"const": {"system": "darwin", "machine": "arm64", "python": "3.13", "distribution": "macos", "release": "unspecified"}},
        {"const": {"system": "darwin", "machine": "x86_64", "python": "3.13", "distribution": "macos", "release": "unspecified"}},
        {"const": {"system": "darwin", "machine": "arm64", "python": "3.14", "distribution": "macos", "release": "unspecified"}},
        {"const": {"system": "darwin", "machine": "x86_64", "python": "3.14", "distribution": "macos", "release": "unspecified"}}
      ]
    },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["system", "machine", "python"],
      "properties": {
        "system": {"$ref": "#/$defs/producerIdentity"},
        "machine": {"$ref": "#/$defs/producerIdentity"},
        "python": {"$ref": "#/$defs/producerIdentity"}
      }
    },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "name", "version", "requires_python", "source_sha256", "authority", "native_artifacts"],
      "properties": {
        "path": {"const": "project"},
        "name": {"const": "bike-sim"},
        "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+!-]*$"},
        "requires_python": {"$ref": "#/$defs/text"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "authority": {"const": "source"},
        "native_artifacts": {"const": "rebuild_on_target"}
      }
    },
    "requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime", "build", "preinstalled", "closure", "wheel_dependency_metadata"],
      "properties": {
        "runtime": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "build": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "preinstalled": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_.-]*[A-Za-z0-9])?==[A-Za-z0-9][A-Za-z0-9_.+!-]*$"}
        },
        "closure": {"const": "not_verified"},
        "wheel_dependency_metadata": {"const": "not_verified"}
      }
    },
    "wheels": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "distribution", "version", "python_tag", "abi_tag", "platform_tag", "sha256"],
        "properties": {
          "path": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "^wheelhouse/[^/]+\\.whl$"}]},
          "distribution": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+!-]*$"},
          "python_tag": {"$ref": "#/$defs/tag"},
          "abi_tag": {"$ref": "#/$defs/tag"},
          "platform_tag": {"$ref": "#/$defs/tag"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "^(?:project/.+|wheelhouse/[^/]+\\.whl|requirements\\.txt)$"}]},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "qualification": {
      "type": "object", "additionalProperties": false,
      "required": ["installation", "native_build", "gui", "binary_compatibility"],
      "properties": {
        "installation": {"const": "not_run"},
        "native_build": {"const": "not_run"},
        "gui": {"const": "not_run"},
        "binary_compatibility": {"const": "not_run"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"profile": {"const": "full"}}},
     "then": {"properties": {"requirements": {"properties": {"preinstalled": {"maxItems": 0}}}}}},
    {"if": {"properties": {"profile": {"const": "slim"}}},
     "then": {"properties": {"requirements": {"properties": {"preinstalled": {"minItems": 1}}}}}}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
    "producerIdentity": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tag": {"type": "string", "pattern": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)*$"},
    "path": {
      "type": "string", "minLength": 1,
      "pattern": "^(?!/)(?!.*[\\\\:\\u0000-\\u001F\\u007F])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*?/$).+$",
      "description": "Canonical relative POSIX path. The validator also rejects symlinks, nonregular files, case/Unicode collisions, excluded machine state and paths outside the fixed layout."
    }
  }
}
