cmake_minimum_required(VERSION 3.27)
foreach(_required SPATIAL_INSTALL_PREFIX SPATIAL_FIXTURE_TOOL)
  if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
    message(FATAL_ERROR "${_required} is required")
  endif()
endforeach()
if(NOT EXISTS "${SPATIAL_INSTALL_PREFIX}/bin/bike-ride")
  message(FATAL_ERROR "installed bike-ride is missing")
endif()
if(NOT EXISTS "${SPATIAL_FIXTURE_TOOL}")
  message(FATAL_ERROR "native spatial fixture tool is missing")
endif()
file(REAL_PATH "${SPATIAL_INSTALL_PREFIX}" _spatial_prefix)
set(_spatial_examples "${_spatial_prefix}/share/bike_sim/examples/spatial")
foreach(_file cross_slope.toml flat.toml free_fast.toml constrained_fast.toml examples_manifest.json)
  if(NOT EXISTS "${_spatial_examples}/${_file}")
    message(FATAL_ERROR "missing installed spatial example ${_file}")
  endif()
endforeach()
if(NOT EXISTS "${_spatial_prefix}/share/bike_sim/recording/catalog-v2.json")
  message(FATAL_ERROR "installed schema2 catalog is missing")
endif()
# Use a fresh directory outside the checkout and the installed prefix.
set(_spatial_temp "/tmp")
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef _spatial_token)
set(_spatial_work "${_spatial_temp}/bike-spatial-product-${_spatial_token}")
if(EXISTS "${_spatial_work}")
  message(FATAL_ERROR "spatial smoke output collision")
endif()
file(MAKE_DIRECTORY "${_spatial_work}")
# A source build may install under its own build directory. Exercise an
# additional copy outside the checkout so absolute build/source paths cannot
# satisfy the product's resource and shared-library lookup accidentally.
file(COPY "${_spatial_prefix}/" DESTINATION "${_spatial_work}/relocated-prefix")
set(_spatial_prefix "${_spatial_work}/relocated-prefix")
set(_spatial_examples "${_spatial_prefix}/share/bike_sim/examples/spatial")
set(ENV{PATH} "/usr/bin:/bin")
set(ENV{PYTHONPATH} "")
set(_spatial_env "${CMAKE_COMMAND}" -E env --unset=DYLD_LIBRARY_PATH
  --unset=DYLD_FALLBACK_LIBRARY_PATH --unset=DYLD_INSERT_LIBRARIES
  --unset=LD_LIBRARY_PATH --unset=LD_PRELOAD)
function(_spatial_ok _name)
  execute_process(COMMAND ${_spatial_env} ${ARGN} WORKING_DIRECTORY "${_spatial_work}"
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 180)
  file(WRITE "${_spatial_work}/${_name}.log" "exit=${_rc}\n${_out}${_err}")
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "${_name} failed (${_rc}); evidence: ${_spatial_work}\n${_out}${_err}")
  endif()
endfunction()
_spatial_ok(ride "${_spatial_prefix}/bin/bike-ride" --spatial 3d
  --terrain3d "${_spatial_examples}/cross_slope.toml" --physics-config "${_spatial_examples}/free_fast.toml"
  --duration 2 --headless --no-plots --record --out "${_spatial_work}/ride")
_spatial_ok(research "${_spatial_prefix}/bin/bike-research" --spatial 3d
  --terrain3d "${_spatial_examples}/flat.toml" --physics-config "${_spatial_examples}/free_fast.toml"
  --rider lumped --duration 2 --motor-torque 0 --record --out "${_spatial_work}/research")
file(GLOB _spatial_recordings LIST_DIRECTORIES TRUE "${_spatial_work}/research/*")
set(_spatial_recording "")
foreach(_candidate IN LISTS _spatial_recordings)
  if(EXISTS "${_candidate}/manifest.json")
    if(NOT _spatial_recording STREQUAL "")
      message(FATAL_ERROR "research smoke produced multiple sealed runs")
    endif()
    set(_spatial_recording "${_candidate}")
  endif()
endforeach()
if(_spatial_recording STREQUAL "")
  message(FATAL_ERROR "research smoke produced no sealed recording")
endif()
_spatial_ok(inspect "${_spatial_prefix}/bin/bike-recording" inspect "${_spatial_recording}")
_spatial_ok(checked "${_spatial_prefix}/bin/bike-replay" --checked "${_spatial_recording}")
_spatial_ok(report "${_spatial_prefix}/bin/bike-recording" report "${_spatial_recording}"
  --episode 0 --output "${_spatial_work}/spatial.html")
# The existing default is legacy and intentionally rejects --duration. An
# explicit physical request supplies the bounded planar compatibility control.
_spatial_ok(planar "${_spatial_prefix}/bin/bike-ride" --physics physical
  --duration 1 --headless --no-plots)
_spatial_ok(planar_fixture "${SPATIAL_FIXTURE_TOOL}" --planar "${_spatial_work}/schema1")
file(GLOB _schema1_runs LIST_DIRECTORIES TRUE "${_spatial_work}/schema1/*")
set(_schema1_found FALSE)
foreach(_candidate IN LISTS _schema1_runs)
  if(EXISTS "${_candidate}/manifest.json")
    _spatial_ok(schema1_reader "${_spatial_prefix}/bin/bike-recording" inspect "${_candidate}")
    set(_schema1_found TRUE)
  endif()
endforeach()
if(NOT _schema1_found)
  message(FATAL_ERROR "schema1 fixture was not published")
endif()
_spatial_ok(incompatible_fixture "${SPATIAL_FIXTURE_TOOL}" --incompatible "${_spatial_recording}" "${_spatial_work}/incompatible")
_spatial_ok(incompatible_inspect "${_spatial_prefix}/bin/bike-recording" inspect "${_spatial_work}/incompatible")
execute_process(COMMAND ${_spatial_env} "${_spatial_prefix}/bin/bike-replay" --checked "${_spatial_work}/incompatible"
  WORKING_DIRECTORY "${_spatial_work}" RESULT_VARIABLE _bad_rc OUTPUT_VARIABLE _bad_out ERROR_VARIABLE _bad_err TIMEOUT 60)
file(WRITE "${_spatial_work}/incompatible_checked.log" "exit=${_bad_rc}\n${_bad_out}${_bad_err}")
if(_bad_rc EQUAL 0 OR NOT "${_bad_out}${_bad_err}" MATCHES "incompatible-execution")
  message(FATAL_ERROR "incompatible execution needs a named nonzero checked result: ${_bad_out}${_bad_err}")
endif()
message(STATUS "Spatial installed-product evidence: ${_spatial_work}")
