# Python-free LLVM tool resolution and real profile-format qualification.
# Included by BikeCompilerPolicy for both build graphs; flags stay there.
include_guard(GLOBAL)

function(_bike_coverage_describe candidate out_path out_version)
  unset(_located)
  if(IS_ABSOLUTE "${candidate}")
    if(EXISTS "${candidate}" AND NOT IS_DIRECTORY "${candidate}")
      set(_located "${candidate}")
    endif()
  else()
    find_program(_located NAMES "${candidate}" NO_CACHE)
  endif()
  if(_located)
    execute_process(COMMAND "${_located}" --version
      RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 30)
    set(_banner "${_out}\n${_err}")
    if(_rc EQUAL 0 AND _banner MATCHES "[Ll][Ll][Vv][Mm]|clang")
      string(REGEX MATCH "([0-9]+)\\.[0-9]+" _version "${_banner}")
      set(_major "${CMAKE_MATCH_1}")
      string(REGEX MATCH "^[0-9]+" _compiler_major "${CMAKE_CXX_COMPILER_VERSION}")
      if(NOT _version STREQUAL "" AND _major STREQUAL _compiler_major)
        string(STRIP "${_banner}" _banner)
        string(REGEX MATCH "^[^\r\n]+" _banner "${_banner}")
        set(${out_path} "${_located}" PARENT_SCOPE)
        set(${out_version} "${_banner}" PARENT_SCOPE)
        return()
      endif()
    endif()
  endif()
  set(${out_path} "" PARENT_SCOPE)
  set(${out_version} "" PARENT_SCOPE)
endfunction()

function(_bike_resolve_coverage_tool tool override out_path out_version)
  if(DEFINED ENV{${override}} AND NOT "$ENV{${override}}" STREQUAL "")
    _bike_coverage_describe("$ENV{${override}}" _path _version)
    if(NOT _path)
      message(FATAL_ERROR "invalid ${override} override: $ENV{${override}} (requires compiler-compatible LLVM major)")
    endif()
  else()
    get_filename_component(_compiler_dir "${CMAKE_CXX_COMPILER}" DIRECTORY)
    get_filename_component(_compiler_name "${CMAKE_CXX_COMPILER}" NAME)
    string(REGEX MATCH "^[0-9]+" _major "${CMAKE_CXX_COMPILER_VERSION}")
    set(_names)
    if(_compiler_name MATCHES "^((.*-)?)(clang\\+\\+|clang)(-([0-9]+(\\.[0-9]+)*))?$")
      set(_prefix "${CMAKE_MATCH_1}")
      set(_suffix "${CMAKE_MATCH_5}")
      if(NOT _suffix STREQUAL "")
        list(APPEND _names "${tool}-${_suffix}" "${_prefix}${tool}-${_suffix}")
      endif()
      list(APPEND _names "${tool}" "${_prefix}${tool}")
    endif()
    list(REMOVE_DUPLICATES _names)
    set(_candidates)
    foreach(_name IN LISTS _names)
      list(APPEND _candidates "${_compiler_dir}/${_name}")
    endforeach()
    list(APPEND _candidates "${tool}-${_major}" "${tool}")
    foreach(_candidate IN LISTS _candidates)
      _bike_coverage_describe("${_candidate}" _path _version)
      if(_path)
        break()
      endif()
    endforeach()
    if(NOT _path AND BIKE_TARGET_SYSTEM STREQUAL "Darwin")
      find_program(_xcrun NAMES xcrun NO_CACHE)
      if(_xcrun)
        execute_process(COMMAND "${_xcrun}" --find "${tool}"
          RESULT_VARIABLE _rc OUTPUT_VARIABLE _candidate ERROR_QUIET
          OUTPUT_STRIP_TRAILING_WHITESPACE TIMEOUT 30)
        if(_rc EQUAL 0)
          _bike_coverage_describe("${_candidate}" _path _version)
        endif()
      endif()
    endif()
    if(NOT _path)
      message(FATAL_ERROR "Cannot resolve ${tool} matching ${CMAKE_CXX_COMPILER} LLVM major ${_major}; checked ${_candidates}")
    endif()
  endif()
  set(${out_path} "${_path}" PARENT_SCOPE)
  set(${out_version} "${_version}" PARENT_SCOPE)
endfunction()

function(_bike_coverage_probe_step directory name)
  execute_process(COMMAND ${ARGN}
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 120)
  _native_json_array(_command_json ${ARGN})
  file(WRITE "${directory}/${name}.command.json" "${_command_json}\n")
  file(WRITE "${directory}/${name}.stdout.log" "${_out}")
  file(WRITE "${directory}/${name}.stderr.log" "${_err}")
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "coverage format probe ${name} failed (${_rc}): ${_err}${_out}; diagnostics: ${directory}")
  endif()
endfunction()

function(bike_qualify_coverage_tools)
  if(NOT CMAKE_CXX_COMPILER_ID MATCHES "^(AppleClang|Clang)$")
    message(FATAL_ERROR "native coverage requires an LLVM clang-family compiler")
  endif()
  _bike_resolve_coverage_tool(llvm-profdata LLVM_PROFDATA _profdata _profdata_version)
  _bike_resolve_coverage_tool(llvm-cov LLVM_COV _cov _cov_version)
  set(_probe "${_bike_policy_probe_dir}/coverage-format")
  file(MAKE_DIRECTORY "${_probe}")
  file(GLOB _old_profiles "${_probe}/control-*.profraw")
  if(_old_profiles)
    file(REMOVE ${_old_profiles})
  endif()
  file(REMOVE "${_probe}/control.profdata" "${_probe}/control")
  file(WRITE "${_probe}/control.cpp" "int main(int argc, char**) { return argc > 1 ? 1 : 0; }\n")
  try_compile(_compiled "${_probe}/build"
    SOURCES "${_probe}/control.cpp"
    CMAKE_FLAGS ${_bike_policy_sysroot_flags}
      "-DCMAKE_CXX_STANDARD:STRING=23" "-DCMAKE_CXX_EXTENSIONS:BOOL=OFF"
    COMPILE_DEFINITIONS -fprofile-instr-generate -fcoverage-mapping
    LINK_OPTIONS -fprofile-instr-generate
    COPY_FILE "${_probe}/control" OUTPUT_VARIABLE _compile_log)
  file(WRITE "${_probe}/control-compile.log" "${_compile_log}")
  if(NOT _compiled)
    message(FATAL_ERROR "coverage format probe compile failed: ${_compile_log}")
  endif()
  _bike_coverage_probe_step("${_probe}" control-run "${CMAKE_COMMAND}" -E env
    "LLVM_PROFILE_FILE=${_probe}/control-%p.profraw" "${_probe}/control")
  file(GLOB _profiles "${_probe}/control-*.profraw")
  if(NOT _profiles)
    message(FATAL_ERROR "coverage format probe emitted no raw profile in ${_probe}")
  endif()
  _bike_coverage_probe_step("${_probe}" control-merge "${_profdata}" merge
    -sparse ${_profiles} -o "${_probe}/control.profdata")
  file(SIZE "${_probe}/control.profdata" _profile_size)
  if(_profile_size EQUAL 0)
    message(FATAL_ERROR "coverage format probe produced an empty merged profile")
  endif()
  _bike_coverage_probe_step("${_probe}" control-export "${_cov}" export
    "${_probe}/control" "-instr-profile=${_probe}/control.profdata")
  file(READ "${_probe}/control-export.stdout.log" _export)
  string(JSON _type ERROR_VARIABLE _error GET "${_export}" type)
  string(JSON _data_size ERROR_VARIABLE _data_error LENGTH "${_export}" data)
  string(JSON _export_version ERROR_VARIABLE _version_error GET "${_export}" version)
  if(_error OR _data_error OR _version_error OR
     NOT _type STREQUAL "llvm.coverage.json.export" OR _data_size LESS 1)
    message(FATAL_ERROR "coverage format probe exported invalid control data: ${_probe}")
  endif()
  foreach(_name profdata cov)
    set(_bike_coverage_${_name} "${_${_name}}" PARENT_SCOPE)
    set(_bike_coverage_${_name}_version "${_${_name}_version}" PARENT_SCOPE)
  endforeach()
  set(BIKE_LLVM_PROFDATA "${_profdata}" CACHE FILEPATH "Qualified llvm-profdata" FORCE)
  set(BIKE_LLVM_COV "${_cov}" CACHE FILEPATH "Qualified llvm-cov" FORCE)
  set(BIKE_CAP_COVERAGE_TOOLS "llvm-profdata=${_profdata} (${_profdata_version}), llvm-cov=${_cov} (${_cov_version})" PARENT_SCOPE)
  set(BIKE_CAP_COVERAGE_FORMAT_PROBE "instrumented control compiled, ran, merged and exported through the resolved tools; export type llvm.coverage.json.export version ${_export_version}" PARENT_SCOPE)
  _native_json_quote(_profdata_json "${_profdata}")
  _native_json_quote(_cov_json "${_cov}")
  _native_json_quote(_profdata_version_json "${_profdata_version}")
  _native_json_quote(_cov_version_json "${_cov_version}")
  _native_json_quote(_export_version_json "${_export_version}")
  file(WRITE "${_bike_policy_probe_dir}/coverage_tool_resolution.json"
    "{\"llvm_profdata\":{\"path\":${_profdata_json},\"version\":${_profdata_version_json}},\"llvm_cov\":{\"path\":${_cov_json},\"version\":${_cov_version_json}},\"format_probe\":{\"format_probe_passed\":true,\"export_version\":${_export_version_json}}}\n")
endfunction()
