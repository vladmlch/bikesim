@@ -395,6 +395,40 @@ def test_rider_toggle_and_mass_telemetry():
     assert 100.0 <= tel_on2["total_mass_kg"] <= 110.0
 
 
+def test_rider_toggle_matches_freshly_compiled_frame_mass_properties():
+    """Ruling R26: _apply_rider_in_place() hardcodes the frame body's mass,
+    ipos and inertia for the [B] rider toggle instead of recompiling. Those
+    literals must match what a fresh compile of the corresponding
+    (mode="dynamic", include_rider=...) configuration actually produces -
+    otherwise the first press of [B] silently writes stale mass properties
+    (e.g. from before Ruling R21 zeroed out the debug marker mass) back into
+    the live model for the rest of the session.
+    """
+    fresh_on = mujoco.MjModel.from_xml_string(generate_mujoco_xml(mode="dynamic", include_rider=True))
+    fresh_off = mujoco.MjModel.from_xml_string(generate_mujoco_xml(mode="dynamic", include_rider=False))
+    fid_fresh = mujoco.mj_name2id(fresh_on, mujoco.mjtObj.mjOBJ_BODY, "frame")
+
+    pg = SuspensionPlayground(mode="dynamic", include_rider=True)
+    fid = mujoco.mj_name2id(pg.model, mujoco.mjtObj.mjOBJ_BODY, "frame")
+
+    # Starts ON: matches a fresh include_rider=True compile.
+    assert pg.model.body_mass[fid] == pytest.approx(fresh_on.body_mass[fid_fresh], abs=1e-6)
+    assert np.allclose(pg.model.body_ipos[fid], fresh_on.body_ipos[fid_fresh], atol=1e-6)
+    assert np.allclose(pg.model.body_inertia[fid], fresh_on.body_inertia[fid_fresh], atol=1e-6)
+
+    # Toggle OFF: matches a fresh include_rider=False compile.
+    pg.toggle_rider()
+    assert pg.model.body_mass[fid] == pytest.approx(fresh_off.body_mass[fid_fresh], abs=1e-6)
+    assert np.allclose(pg.model.body_ipos[fid], fresh_off.body_ipos[fid_fresh], atol=1e-6)
+    assert np.allclose(pg.model.body_inertia[fid], fresh_off.body_inertia[fid_fresh], atol=1e-6)
+
+    # Toggle back ON: matches the fresh include_rider=True compile again.
+    pg.toggle_rider()
+    assert pg.model.body_mass[fid] == pytest.approx(fresh_on.body_mass[fid_fresh], abs=1e-6)
+    assert np.allclose(pg.model.body_ipos[fid], fresh_on.body_ipos[fid_fresh], atol=1e-6)
+    assert np.allclose(pg.model.body_inertia[fid], fresh_on.body_inertia[fid_fresh], atol=1e-6)
+
+
 def test_bump_and_pit_scaling():
     """Verifies that bump and pit scale adjustments correctly update scale factors within bounds [0.2, 3.0]."""
     pg = SuspensionPlayground(mode="dynamic", bump_scale=1.0, pit_scale=1.0)
